[Unit]
Description=Codex usage limit Telegram notifier
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=codexbot
Group=codexbot
WorkingDirectory=/opt/codex-limit-bot/current
Environment=HOME=/var/lib/codex-limit-bot
Environment=CODEX_HOME=/var/lib/codex-limit-bot/.codex
EnvironmentFile=/etc/codex-limit-bot.env
ExecStart=/opt/codex-limit-bot/current/.venv/bin/python /opt/codex-limit-bot/current/bot.py --codex /opt/codex-limit-bot/shared/bin/codex
StateDirectory=codex-limit-bot
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codex-limit-bot

[Install]
WantedBy=multi-user.target
