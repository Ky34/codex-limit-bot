#!/usr/bin/env python3
"""Validate the complete systemd policy used by codex-limit-bot."""

from __future__ import annotations

import sys
from pathlib import Path


APP_ROOT = "/opt/codex-limit-bot"
CURRENT = f"{APP_ROOT}/current"
SHARED_CODEX = f"{APP_ROOT}/shared/bin/codex"
STATE = "/var/lib/codex-limit-bot"
ENV_FILE = "/etc/codex-limit-bot.env"


EXPECTED = {
    "codex-limit-bot.service": {
        "Unit": {
            "Description": ["Codex usage limit Telegram notifier"],
            "Wants": ["network-online.target"],
            "After": ["network-online.target"],
        },
        "Service": {
            "Type": ["oneshot"],
            "User": ["codexbot"],
            "Group": ["codexbot"],
            "WorkingDirectory": [CURRENT],
            "Environment": [f"HOME={STATE}", f"CODEX_HOME={STATE}/.codex"],
            "EnvironmentFile": [ENV_FILE],
            "ExecStart": [f"{CURRENT}/.venv/bin/python {CURRENT}/bot.py --codex {SHARED_CODEX}"],
            "StateDirectory": ["codex-limit-bot"],
            "StateDirectoryMode": ["0700"],
            "NoNewPrivileges": ["true"],
            "PrivateTmp": ["true"],
            "ProtectSystem": ["strict"],
            "ProtectHome": ["true"],
            "ReadWritePaths": [STATE],
        },
        "Install": {"WantedBy": ["multi-user.target"]},
    },
    "codex-limit-bot-listener.service": {
        "Unit": {
            "Description": ["Telegram commands for Codex usage limit bot"],
            "Wants": ["network-online.target"],
            "After": ["network-online.target"],
        },
        "Service": {
            "Type": ["simple"],
            "User": ["codexbot"],
            "Group": ["codexbot"],
            "WorkingDirectory": [CURRENT],
            "Environment": [f"HOME={STATE}", f"CODEX_HOME={STATE}/.codex"],
            "EnvironmentFile": [ENV_FILE],
            "ExecStart": [f"{CURRENT}/.venv/bin/python {CURRENT}/bot.py --codex {SHARED_CODEX} --listen"],
            "Restart": ["always"],
            "RestartSec": ["5s"],
            "StateDirectory": ["codex-limit-bot"],
            "StateDirectoryMode": ["0700"],
            "NoNewPrivileges": ["true"],
            "PrivateTmp": ["true"],
            "ProtectSystem": ["strict"],
            "ProtectHome": ["true"],
            "ReadWritePaths": [STATE],
        },
        "Install": {"WantedBy": ["multi-user.target"]},
    },
    "codex-limit-bot.timer": {
        "Unit": {"Description": ["Check Codex usage limits every minute"]},
        "Timer": {
            "OnBootSec": ["1min"],
            "OnUnitActiveSec": ["1min"],
            "AccuracySec": ["1s"],
            "RandomizedDelaySec": ["0"],
            "Persistent": ["true"],
            "Unit": ["codex-limit-bot.service"],
        },
        "Install": {"WantedBy": ["timers.target"]},
    },
}


def parse_unit(path: Path) -> dict[str, dict[str, list[str]]]:
    sections: dict[str, dict[str, list[str]]] = {}
    current: str | None = None
    for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith(("#", ";")):
            continue
        if raw[:1].isspace():
            raise ValueError(f"{path}:{number}: continuation or indented line is not allowed")
        if line.startswith("[") and line.endswith("]"):
            current = line[1:-1]
            if not current or current in sections:
                raise ValueError(f"{path}:{number}: invalid or repeated section")
            sections[current] = {}
            continue
        if current is None or "=" not in line:
            raise ValueError(f"{path}:{number}: invalid directive")
        key, value = line.split("=", 1)
        if not key or key.strip() != key:
            raise ValueError(f"{path}:{number}: invalid directive name")
        sections[current].setdefault(key, []).append(value)
    return sections


def main() -> int:
    if len(sys.argv) != 2:
        print(f"Usage: {sys.argv[0]} <directory-containing-units>", file=sys.stderr)
        return 64
    root = Path(sys.argv[1])
    for name, expected in EXPECTED.items():
        path = root / name
        if not path.is_file() or path.is_symlink():
            raise ValueError(f"missing or invalid unit: {path}")
        actual = parse_unit(path)
        if actual != expected:
            raise ValueError(f"systemd policy mismatch: {path}")
    print("codex-limit-bot systemd policy passed")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError) as exc:
        print(f"systemd policy check failed: {exc}", file=sys.stderr)
        raise SystemExit(1)
