#!/usr/bin/env bash
set -Eeuo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
unset CDPATH ENV BASH_ENV

readonly original="${SSH_ORIGINAL_COMMAND:-}"
if [[ "${original}" =~ ^deploy\ ([0-9a-f]{40})$ ]]; then
  exec sudo -n /usr/local/sbin/deploy-codex-limit-bot "${BASH_REMATCH[1]}"
fi

echo "Only 'deploy <40-character-lowercase-git-sha>' is allowed." >&2
exit 126
